# Copy this file to .env and fill in your keys. .env is gitignored.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# LYRA_CLAUDE_MODEL=claude-sonnet-5-5
# LYRA_IMAGE_MODEL=gemini-3.1-flash-image
# LYRA_MOCK=1            # force preview mode (no API calls). Use "claude" or "images" to mock only one.
# LYRA_DATA_DIR=storage  # where the database, uploads and renders live
